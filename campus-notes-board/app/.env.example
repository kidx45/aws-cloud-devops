# Names only. Copy this to a real env file OUTSIDE your repository (for example /etc/notes/notes.env),
# fill in your own values, and protect it with chmod 600. Never commit the real file.
#
# Format rules (so systemd can load it): one KEY=value per line, no spaces around "=", no "export".

# Database (your RDS endpoint and the dedicated application user, not the admin user)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_app_user
DB_PASSWORD=replace-me

# S3 bucket and the Region it lives in. There are NO access keys here: the EC2 role provides credentials.
S3_BUCKET=your-bucket-name
AWS_REGION=your-region

# Optional
MAX_UPLOAD_MB=10
